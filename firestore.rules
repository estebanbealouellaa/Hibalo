rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // An admin is a signed-in user whose own users document has role 'admin'.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Translations dictionary: public read, no writes.
    match /translations/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Sign-up (role 'user') or the first progress sync (no role field).
      allow create: if isOwner(uid)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user');

      // The owner may change anything except role; admins may change anything.
      allow update: if (isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || isAdmin();

      allow delete: if isOwner(uid) || isAdmin();

      // Admins may read progress and delete it when they delete the user.
      match /lessonProgress/{lessonId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
        allow delete: if isAdmin();
      }

      match /quizAttempts/{attemptId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
        allow delete: if isAdmin();
      }
    }

    // Owner = the uid field.
    match /camera_translations/{docId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Owner = the uid field.
    match /library/{docId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Everything else is closed (no catch-all).
  }
}

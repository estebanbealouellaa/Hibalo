<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting (dark mode).
         V6 violet with the firefly (drawable/launch_background.xml). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started,
         behind the Flutter UI while it starts: violet, so the hand-over to
         the Flutter splash shows no white frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/hibalo_violet</item>
    </style>
</resources>

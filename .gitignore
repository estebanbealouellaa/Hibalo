#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local editor and tool settings
.claude/
.vscode/
devtools_options.yaml

# Working files (exports, screenshots, scratch): local only
Claude outputs/

# Kotlin compiler sessions
android/.kotlin/

# docs/: only the guides the code refers to are in the repo; drafts, zips, CSVs,
# build plans and handoffs stay local
/docs/*
!/docs/LEARNING_BEHAVIOR.md
!/docs/LEARNING_TEMPLATES.md
!/docs/FUTURE_FEATURES.md
!/docs/translation/

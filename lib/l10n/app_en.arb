    "description": "Privacy policy."
  },
  "privacyNotSaveLabel": "What we don't save",
  "@privacyNotSaveLabel": {
    "description": "Privacy policy."
  },
  "privacyNotSaveText": "the text you translate, the pictures you scan and your voice. Your translation history and saved words are kept only on your phone; uninstalling the app or clearing them in Settings deletes them. Translation and picture reading happen on your phone. Speech-to-text uses your phone's own speech service, which may follow Google's privacy terms. Speaking practice in lessons is kept on your phone only while you use it, then deleted.",
  "@privacyNotSaveText": {
    "description": "Privacy policy."
  },

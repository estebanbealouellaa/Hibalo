  "helpFaqTitle": "Frequently asked questions",
  "@helpFaqTitle": {
    "description": "Help."
  },
  "helpQ1": "How do I translate a photo?",
  "@helpQ1": {
    "description": "Help."
  },
  "helpA1": "On Translate, tap the camera button, then take a photo or choose one from your gallery. Check the text Hibalo reads and fix any mistakes; the translation appears below.",
  "@helpA1": {
    "description": "Help."
  },
  "helpQ2": "Does Hibalo work without internet?",
  "@helpQ2": {
    "description": "Help."
  },
  "helpA2": "Yes, after you sign in once. Translating, reading photos, the Hiligaynon voice and the lessons work offline. Your progress is saved to your account when you are back online. Speaking to translate uses your phone's speech service, which may need internet.",
  "@helpA2": {
    "description": "Help."
  },
  "helpQ3": "What if a translation looks wrong?",
  "@helpQ3": {
    "description": "Help."
  },
  "helpA3": "Translations are made on your phone and may not be exact. Try a shorter sentence or check the spelling. For voice and photos, fix the text in the box, then tap Translate.",
  "@helpA3": {
    "description": "Help."
  },
  "helpQ4": "How do I unlock the next lesson?",
  "@helpQ4": {
    "description": "Help."
  },
  "helpA4": "Pass the lesson's quiz with at least 80%. Lesson 2 unlocks when you finish Lesson 1.",
  "@helpA4": {
    "description": "Help."
  },
  "helpQ5": "How do I earn XP?",
  "@helpQ5": {
    "description": "Help."
  },
  "helpA5": "Finish a lesson (20 XP), answer a quick check right (5 XP) or answer a quiz question right (10 XP). Each one gives XP only the first time.",
  "@helpA5": {
    "description": "Help."
  },
  "helpQ6": "How do I change my avatar?",
  "@helpQ6": {
    "description": "Help."
  },
  "helpA6": "Go to Me, tap Edit profile, choose an avatar, then tap Save changes.",
  "@helpA6": {
    "description": "Help."
  },
